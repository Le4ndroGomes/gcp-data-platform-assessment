{"model": {"tables": [{"name": "Receita", "columns": [{"name": "valor", "dataType": "decimal"}, {"name": "margem", "type": "calculated", "expression": "[valor]*0.2"}], "measures": [{"name": "Receita Total", "expression": "SUM(Receita[valor])"}, {"name": "Receita YTD", "expression": "TOTALYTD([Receita Total], Calendario[Data])"}, {"name": "Ranking Unidade", "expression": "RANKX(ALL(Unidade), CALCULATE(SUMX(Receita, Receita[valor] * Receita[qt])))"}], "partitions": [{"name": "p", "mode": "directQuery", "source": {"type": "m", "expression": ["let", "    Source = GoogleBigQuery.Database([BillingProject=\"rx-bi-prd\"]),", "    q = Value.NativeQuery(Source{[Name=\"rx-bi-prd\"]}[Data], \"SELECT u.nm_unidade, SUM(f.vl_total) AS valor FROM `rx-dados-prd.dw_faturamento.faturamento_faturamento` f JOIN `rx-dados-prd.dw_faturamento.faturamento_unidade` u ON f.id_unidade = u.id_unidade OR f.id_unidade_origem = u.id_unidade GROUP BY 1\", null, [EnableFolding=true])", "in", "    q"]}}]}, {"name": "Calendario", "partitions": [{"name": "c", "mode": "import", "source": {"type": "calculated", "expression": "CALENDARAUTO()"}}], "columns": [{"name": "Data", "dataType": "dateTime"}]}], "relationships": [{"name": "r1", "fromTable": "Receita", "fromColumn": "data", "toTable": "Calendario", "toColumn": "Data"}], "roles": [], "expressions": []}}